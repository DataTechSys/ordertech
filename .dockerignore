# Keep Docker build context minimal and fast for OrderTech Cloud Run deployment
# Optimized to reduce deployment time by excluding unnecessary files

# ============================================================================
# VCS / Editor / OS
# ============================================================================
.dockerignore
.gcloudignore
.git
.gitignore
.github
.vscode
.idea
.warp
*.swp
*.swo
.DS_Store

# ============================================================================
# Dependencies and caches (will be installed fresh in container)
# ============================================================================
node_modules
**/node_modules
**/.cache
npm-debug.log*
yarn-error.log*
.pnpm-store
**/.turbo
**/.parcel-cache
**/.vite
**/.next/cache

# ============================================================================
# Large projects and assets (NOT needed for Cloud Run)
# ============================================================================
# AI Assistant project (4.5GB) - separate application
koobs-ai-assistant
# C++ Whisper library (219MB) - not needed for web service
whisper.cpp
# Static media assets - should be served from Google Cloud Storage
images
photos
data
public/images

# ============================================================================
# Build outputs (will be rebuilt in container)
# ============================================================================
build
dist
out
.out
.next
coverage
**/build
**/dist
**/coverage

# ============================================================================
# Native projects and apps (not needed for web service)
# ============================================================================
CashierApp
DisplayApp
ios-cashier
ios
Archive
OrderTechCore
Sources
*.xcodeproj
*.xcworkspace
*.xcuserdatad
*.xcuserstate
*.xcassets
*.xcconfig
DerivedData
**/DerivedData
*.xcbuilddata
*.xcent
*.xcent.der
*.app
*.ipa
*.dSYM
macos

# Kiosk artifacts
kiosk
kiosk-shell

# ============================================================================
# Backups, logs, temp files (1GB+ of unnecessary data)
# ============================================================================
.backups
backup
server.js.backup
logs
.logs
*.log
tmp
temp_audio
nohup.out
.pid
*.pid
server_data
_pginfo

# ============================================================================
# Development and unused directories
# ============================================================================
dev
docs
inventory
__OLD__
DriveWeb
sidebar
posters
profile
signup
start-trial
verify-email
web
monitoring
reports

# ============================================================================
# Static HTML UI directories (using iOS apps instead)
# Exclude until needed - can re-enable specific ones later
# Note: admin directory is now included for consolidated admin dashboard
# ============================================================================
drive
products
tenants
categories
modifiers
orders
company
users
roles
branches
devices
billing
poster
messages
platform
# login - INCLUDED: login page needed for admin access
cashier

# ============================================================================
# Environment and secrets
# ============================================================================
.env*
.envrc
*.local
cloud-sql-proxy
cloud-sql-proxy*
cloud_sql_proxy*

# ============================================================================
# Test files
# ============================================================================
test
**/*.test.js
**/*.spec.js

# ============================================================================
# Fonts (can be served via CDN/GCS in future)
# ============================================================================
fonts
public/fonts

# ============================================================================
# Local development files
# ============================================================================
docker-compose.yml

# ============================================================================
# Root-level docs and data files (exclude all, keep only essential configs)
# ============================================================================
/*.md
/*.sql
/*.csv

# Root-level media files (exclude test/sample files)
/poster-defualt.png
/ordertech.png
/test-image.png
/placeholder.jpg
/Black-Spanish.jpg
/iced-americano.jpg
/*.mp3
/*.wav
/*.ogg

