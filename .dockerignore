# Keep Docker build context minimal and fast for OrderTech Cloud Run deployment

# VCS / Editor
.dockerignore
.gcloudignore
.git
.gitignore
.github
.vscode
.idea
.warp
*.swp
*.swo

# Dependencies and caches (will be installed fresh in container)
node_modules
**/node_modules
**/.cache
**/.DS_Store
npm-debug.log*
yarn-error.log*
.pnpm-store
**/.turbo
**/.parcel-cache
**/.vite
**/.next/cache

# Documentation and ops inventories
docs
inventory

# Build outputs (will be rebuilt in container)
build
dist
.out
.next
coverage
**/build
**/dist
**/coverage

# Non-service apps and native projects (not needed for web service)
CashierApp
DisplayApp
ios-cashier
ios
Archive
OrderTechCore
*.xcodeproj
*.xcworkspace
*.xcuserdatad
*.xcuserstate
*.xcassets
*.xcconfig
DerivedData
**/DerivedData
*.xcbuilddata
*.xcent
*.xcent.der
*.app
*.ipa
*.dSYM
macos

# Kiosk artifacts (not needed for web service)
kiosk
kiosk-shell

# LARGE EXCLUSIONS: Heavy projects and assets
# AI Assistant project (4.5GB) - separate application
koobs-ai-assistant
# C++ Whisper library (219MB) - not needed for web service
whisper.cpp
# Static media assets (111MB total) - should be served from Google Cloud Storage
images
photos
data
# Keep only essential public assets that can't be moved to GCS yet
# public/images - commented out for now, review if these are essential

# Logs, temp, and dev files
logs
*.log
tmp
nohup.out
.logs
.pid
server_data

# Local development and environment files
docker-compose.yml
.env*
.envrc
*.local
cloud-sql-proxy

# Test files
test
**/*.test.js
**/*.spec.js

# --------------------------------------------------------------------
# Deployment optimization (Cloud Run): Exclude large/static artifacts
# These are either hosted on GCS bucket "ordertech.me" or not needed
# at runtime. Reduces Docker build context and speeds up deployments.
# Added: ~60MB reduction (public/images 25MB, cloud-sql-proxy 31MB, fonts 1.2MB, etc.)
# --------------------------------------------------------------------

# 1) Static images served from GCS bucket
public/images

# 2) Local dev database proxy tool (not needed in Cloud Run)
# Cloud Run uses connectors/managed auth for Cloud SQL connection
cloud-sql-proxy*
cloud_sql_proxy*

# 3) Fonts (can be served via CDN/GCS in future)
fonts
public/fonts

# 4) Backups and temp files (not needed in production container)
backup
.backups
*.backup
server.js.backup

# 5) Root-level sample/test image files (dev/test only)
# These are not needed in production containers
/poster-defualt.png
/ordertech.png
/iced-americano.jpg
/Black-Spanish.jpg
/placeholder.jpg
/test-image.png
