FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --omit=dev --no-audit --no-fund

# Copy job script
COPY foodics-sync-ingredients.js ./

# Make executable
RUN chmod +x foodics-sync-ingredients.js

# Run the job
CMD ["node", "foodics-sync-ingredients.js"]
