# Example runtime variables for RTC server
# Copy to your process manager or Docker env; do NOT commit real values.

# General
NODE_ENV=production
PORT=8080
GCP_SECRETS_ENABLE=1
GCP_PROJECT_ID=your-gcp-project-id

# LiveKit via Google Secret Manager (preferred)
# Set to GSM secret IDs (short) or full resource paths (projects/.../secrets/.../versions/latest)
LIVEKIT_WS_URL_SECRET=livekit-ws-url
LIVEKIT_API_KEY_SECRET=livekit-api-key
LIVEKIT_API_SECRET_SECRET=livekit-api-secret

# Alternatively, set raw envs directly (NOT both)
# LIVEKIT_WS_URL=wss://rtc.ordertech.me
# LIVEKIT_API_KEY=your_api_key
# LIVEKIT_API_SECRET=your_api_secret

# Optional TURN via env (self-hosted coturn)
# TURN_URLS=turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=username
# TURN_PASSWORD=password

# Twilio (optional; for P2P ICE or Twilio Video fallback) — load from GSM if possible
TWILIO_ACCOUNT_SID_SECRET=twilio-account-sid
TWILIO_KEY_SID_SECRET=twilio-key-sid
TWILIO_KEY_SECRET_SECRET=twilio-key-secret

# Fallback order for RTC providers
RTC_FALLBACK_ORDER=p2p,livekit,twilio
