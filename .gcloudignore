# Keep Cloud Run source uploads minimal for the main service

# This file controls what gets uploaded when using:
#   gcloud run deploy --source .
# It does NOT affect sub-service deploys from subdirectories.

# VCS and editor cruft
.gcloudignore
.git
.gitignore
.github
.vscode
.idea
.warp

# Dependencies and caches
node_modules
**/node_modules
**/.cache
**/.DS_Store

# Documentation and ops inventories
docs
inventory

# Non-service apps and native (exclude Xcode and iOS projects/builds)
CashierApp
DisplayApp
ios-cashier
ios
Archive
OrderTechCore
*.xcodeproj
*.xcworkspace
*.xcuserdatad
*.xcuserstate
*.xcassets
*.xcconfig
DerivedData
**/DerivedData
*.xcbuilddata
*.xcent
*.xcent.der
*.app
*.ipa
*.dSYM

# Kiosk artifacts (you confirmed these can be excluded)
kiosk
kiosk-shell

# Heavy/static assets now served from GCS
images
photos
data

# LARGE EXCLUSIONS: Heavy projects not needed for Cloud Run service
# AI Assistant project (4.5GB) - separate application
koobs-ai-assistant
# C++ Whisper library (219MB) - not needed for web service
whisper.cpp
# macOS projects (126MB) - not needed for web service
macos

# Generic build outputs
build
dist
**/build
**/dist

# Logs and temp
logs
*.log
tmp
nohup.out
.logs
.pid
server_data
cloud-sql-proxy

# --------------------------------------------------------------------
# Deployment optimization (Cloud Run): Exclude large/static artifacts
# These are hosted on GCS bucket "ordertech.me" or not needed at runtime.
# This reduces upload size to Cloud Build and speeds up deployments.
# Added: ~60MB reduction (public/images 25MB, cloud-sql-proxy 31MB, fonts 1.2MB, etc.)
# --------------------------------------------------------------------

# 1) Static images served from GCS bucket
public/images

# 2) Local dev database proxy tool (not needed in Cloud Run)
# Cloud Run uses connectors/managed auth for Cloud SQL connection
cloud-sql-proxy*
cloud_sql_proxy*

# 3) Fonts (can be served via CDN/GCS in future)
fonts
public/fonts

# 4) Backups and temp files (not needed in production container)
backup
.backups
*.backup
server.js.backup

# 5) Root-level sample/test image files (dev/test only)
# These are not needed in production containers
/poster-defualt.png
/ordertech.png
/iced-americano.jpg
/Black-Spanish.jpg
/placeholder.jpg
/test-image.png
